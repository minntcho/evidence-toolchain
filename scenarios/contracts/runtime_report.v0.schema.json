{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic.runtime_report.v0",
  "type": "object",
  "required": [
    "case_id",
    "status",
    "artifacts",
    "predicates",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "carrier",
          "reader",
          "reader_status",
          "observation_count",
          "issue_count"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^input/"
          },
          "carrier": {
            "type": "string",
            "enum": [
              "csv",
              "xlsx"
            ]
          },
          "reader": {
            "type": "string",
            "minLength": 1
          },
          "reader_status": {
            "type": "string",
            "enum": [
              "ingested",
              "failed"
            ]
          },
          "observation_count": {
            "type": "integer",
            "minimum": 0
          },
          "issue_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "required": [
        "manifest",
        "carrier_trace",
        "verification_report"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "string",
          "const": "_synthetic/manifest.json"
        },
        "carrier_trace": {
          "type": "string",
          "const": "_synthetic/carrier_trace.json"
        },
        "verification_report": {
          "type": "string",
          "const": "_synthetic/verification_report.json"
        }
      }
    }
  }
}
